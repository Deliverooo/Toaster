#version 460
#define __MESH__

#extension GL_GOOGLE_include_directive: require
#include "common.glsl"

struct DrawMeshTasksIndirectCommand
{
    uint32 workGroupsX;
    uint32 workGroupsY;
    uint32 workGroupsZ;

    uint32 objectId; // Index into the object data buffer
};

layout (buffer_reference, scalar) readonly buffer IndirectCommandBuffer { DrawMeshTasksIndirectCommand commands[]; };

layout (push_constant) uniform PushData
{
    CameraBuffer camera;
    ObjectDataBuffer objectBuffer;
    uintptr materialBuffer;
    TransformDataBuffer transformBuffer;
    MeshMetadataBuffer meshMetadataBuffer;
    IndirectCommandBuffer indirectBuffer;

    uint32 samplerId;
    uint32 _padd[1u];
} pcs;

layout (local_size_x = WARP_SIZE, local_size_y = 1u, local_size_z = 1u) in; // 32 is the NVIDIA warp size
layout (triangles, max_vertices = 64u, max_primitives = 128u) out;

layout (location = 0) out float3 o_Position[];
layout (location = 1) out float3 o_WorldPos[];
layout (location = 2) out float2 o_TexCoord[];
layout (location = 3) flat out uint32 o_MaterialIndex[];

struct TaskPayload
{
    uint32 objectId;
    uint32 meshletIds[WARP_SIZE];
};

taskPayloadSharedEXT TaskPayload taskPayload;

void main()
{
    ObjectData obj_data = pcs.objectBuffer.data[taskPayload.objectId];

    MeshMetadata metadata = pcs.meshMetadataBuffer.metadata[obj_data.meshId];

    uint32 meshlet_index = uint32(metadata.meshletBufferOffset) + taskPayload.meshletIds[gl_WorkGroupID.x];

    Meshlet meshlet = meshletPages[metadata.meshletBufferPageId].meshlets[meshlet_index];

    SetMeshOutputsEXT(meshlet.vertexCount, meshlet.triangleCount);

    uint32 thread_id = gl_LocalInvocationID.x;

    for (uint32 vertex_id = thread_id; vertex_id < meshlet.vertexCount; vertex_id += gl_WorkGroupSize.x)
    {
        uint32 vertex_index = meshletVertexPages[metadata.meshletVertexBufferPageId].vertices[metadata.meshletVertexBufferOffset + uint32(meshlet.vertexOffset) + vertex_id];

        Vertex vertex = vertexPages[metadata.vertexBufferPageId].vertices[metadata.vertexBufferOffset + vertex_index];

        float4x4 transform = pcs.transformBuffer.data[obj_data.transformId];

        float4 world_pos = transform * float4(vertex.position.xyz, 1.0f);
        o_Position[vertex_id] = vertex.position.xyz;
        o_WorldPos[vertex_id] = world_pos.xyz;

        float4 view_pos = pcs.camera.view * world_pos;

        o_TexCoord[vertex_id] = vertex.texCoord;

        uint32 material_index = materialIndirectionPages[metadata.materialIndirectionBufferPageId].materials[metadata.materialIndirectionBufferOffset + meshlet.materialIndex];
        o_MaterialIndex[vertex_id] = material_index;

        gl_MeshVerticesEXT[vertex_id].gl_Position = pcs.camera.proj * view_pos;
    }

    for (uint32 triangle_id = thread_id; triangle_id < meshlet.triangleCount; triangle_id += gl_WorkGroupSize.x)
    {
        uint32 triangle_index = uint32(metadata.meshletTriangleBufferOffset) + uint32(meshlet.triangleOffset) + triangle_id * 3u;

        gl_PrimitiveTriangleIndicesEXT[triangle_id] = uint3(
            meshletTrianglePages[metadata.meshletTriangleBufferPageId].indices[triangle_index + 0u],
            meshletTrianglePages[metadata.meshletTriangleBufferPageId].indices[triangle_index + 1u],
            meshletTrianglePages[metadata.meshletTriangleBufferPageId].indices[triangle_index + 2u]
        );
    }
}